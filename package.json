{
  "name": "kanban-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Kanban Desktop —— 三 CLI 统一聊天 GUI 的 Electron 桌面应用（pnpm workspace 根）",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @kanban/desktop dev",
    "build": "pnpm --filter @kanban/desktop build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @kanban/desktop test:e2e",
    "lint": "oxlint apps packages",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "oxlint": "^1.89.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "node-pty"
    ]
  }
}
