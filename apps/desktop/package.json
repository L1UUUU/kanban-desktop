{
  "name": "@kanban/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Kanban Desktop 主应用（Electron 44 + electron-vite + React 19 + Tailwind v4）",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "smoke:sqlite": "electron scripts/smoke-node-sqlite.cjs"
  },
  "dependencies": {
    "@kanban/cli-host": "workspace:*",
    "@kanban/ipc-schema": "workspace:*",
    "@kanban/tracker": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.10.2",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.69.0",
    "playwright": "^1.64.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
